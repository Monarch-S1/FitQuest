# ─── Supabase Configuration ──────────────────────────────────────────
# Copy this file to .env and fill in your Supabase project credentials.
#
#   cp .env.example .env
#
# Get these values from your Supabase project dashboard:
#   Project Settings → API → Project URL + anon/public key
#
# IMPORTANT: Never commit the .env file to git.

# Your Supabase project URL (e.g., https://your-project.supabase.co)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase anon/public key (NOT the service_role key!)
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Sentry Configuration (optional) ─────────────────────────────────
# Get your DSN from https://sentry.io → Project Settings → Client Keys
# Leave empty to disable crash reporting in development
#
# EXPO_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/project-id
