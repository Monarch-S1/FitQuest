{
  "expo": {
    "name": "ARCH",
    "slug": "arch",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "arch",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F1115",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.monarch.arch",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F1115",
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e5f54d00-a6c4-4e3a-87ea-4f88ff38badd"
      }
    },
    "owner": "bored_wanderer",
    "updates": {
      "url": "https://u.expo.dev/e5f54d00-a6c4-4e3a-87ea-4f88ff38badd"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
